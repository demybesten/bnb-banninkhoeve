// prisma/schema.prisma
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_DATABASE_URL")
}

model Room {
  id          Int          @id @default(autoincrement())
  name        String
  description String
  price       Float
  capacity    Int
  amenities   String
  images      String
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  bookings    Booking[]
  icalSources IcalSource[]
}

model Admin {
  id       Int    @id @default(autoincrement())
  username String @unique
  password String
}

model Booking {
  id        Int      @id @default(autoincrement())
  roomId    Int
  room      Room     @relation(fields: [roomId], references: [id], onDelete: Cascade)
  checkIn   DateTime
  checkOut  DateTime
  guestName String?
  status    String   @default("confirmed") // confirmed, cancelled
  source    String?  // "manual", "airbnb", "bedandbreakfast", etc.
  icalUid   String?  // VEVENT UID from iCal feed (for deduplication)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model IcalSource {
  id        Int       @id @default(autoincrement())
  roomId    Int
  room      Room      @relation(fields: [roomId], references: [id], onDelete: Cascade)
  name      String    // "Airbnb", "Bedandbreakfast", etc.
  url       String    // The .ics URL
  enabled   Boolean   @default(true)
  lastSync  DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}