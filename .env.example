# Database (Vercel Postgres)
DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require"

# Vercel Blob Storage (image uploads)
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_..."

# Auth
JWT_SECRET="your-secret-key-here"
CRON_SECRET="your-cron-secret-here"

# Google Maps
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY="your-maps-api-key"
GOOGLE_PLACES_API_KEY="your-places-api-key"
NEXT_PUBLIC_GOOGLE_PLACE_ID="your-place-id"

# EmailJS (contact & booking forms)
NEXT_PUBLIC_EMAILJS_SERVICE_ID="your-service-id"
NEXT_PUBLIC_EMAILJS_CONTACT_TEMPLATE_ID="your-contact-template-id"
NEXT_PUBLIC_EMAILJS_BOOKING_TEMPLATE_ID="your-booking-template-id"
NEXT_PUBLIC_EMAILJS_PUBLIC_KEY="your-public-key"

# Optional: SMTP fallback (if not using EmailJS)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER="your-email@gmail.com"
SMTP_PASS="your-app-password"
SMTP_FROM="website@cozybnb.com"
ADMIN_EMAIL="info@cozybnb.com"

# Optional: Webhook for form submissions
CONTACT_WEBHOOK_URL=""
